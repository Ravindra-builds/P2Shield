{
  "manifest_version": 3,
  "name": "TechKnights Privacy Firewall",
  "version": "0.1.0",
  "description": "Cleans your prompt on this device before any AI chatbot sees it. Detects personal data, credentials and confidential details, then replaces them. No servers.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "TechKnights Privacy Firewall: open settings and playground",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["storage", "contextMenus", "offscreen", "clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "protect-focused": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Protect the text in the focused box"
    }
  },
  "storage": { "managed_schema": "managed_schema.json" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
