{
  "name": "p2shield",
  "version": "0.1.0",
  "private": true,
  "description": "P2Shield, a pre-LLM privacy firewall: a Chrome extension that sanitizes prompts locally before they reach any chatbot.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "e2e": "node e2e/run.mjs",
    "demo": "node demo/serve.mjs",
    "landing": "npm --prefix \"landing page\" run dev",
    "build:landing": "npm --prefix \"landing page\" run build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.4",
    "@types/node": "24.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
